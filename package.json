{
  "name": "sculpin-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "10.28.1"
  },
  "scripts": {
    "dev": "turbo build && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:smoke": "node --env-file=.env --import tsx scripts/check-dev-environment.ts",
    "test:integration": "node --env-file=.env scripts/run-db-integration.mjs",
    "db:migrate:deploy": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.17.2",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4",
    "tsx": "4.20.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
