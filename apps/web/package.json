{
  "name": "@sculpin/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --workspace-root turbo build --filter=@sculpin/web^...",
    "dev": "node --env-file=../../.env ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sculpin/api-contracts": "workspace:*",
    "@sculpin/config": "workspace:*",
    "@sculpin/db": "workspace:*",
    "@sculpin/observability": "workspace:*",
    "next": "15.5.7",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7"
  }
}
