NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://sculpin:local-development-only@localhost:5432/sculpin_hub
PORT=3002
PROXY_PORT=3001
PROXY_HOST=127.0.0.1
PROXY_BODY_LIMIT_BYTES=1048576
PROXY_SHUTDOWN_TIMEOUT_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
# Data-plane deployment configuration (M6/M7). These are the Hub's OWN names —
# the Hub does not adopt Sculpin's internal env-var naming as its public contract.
# All four are DEPLOYMENT-ONLY: never sourced from a request, catalogue record,
# ordinary admin form, or PAT. Production secrets come from Azure Key Vault.
# Canonical public Hub origin used to render connection instructions (never from a
# request Host header). Must be a non-local https:// origin in production.
HUB_PUBLIC_URL=http://localhost:3002
# Internal Sculpin base URL the Hub proxies to. Never exposed to clients (no SSRF).
SCULPIN_UPSTREAM_URL=http://localhost:8001
# Server secret the Hub sends upstream as `Authorization: Bearer ...`. Never stored
# in the DB, returned to clients, logged, or recorded in usage events.
SCULPIN_UPSTREAM_API_KEY=
# Least-privilege Sculpin credential used ONLY by admin-side catalogue discovery
# (server-side `GET /v1/models`). Deliberately SEPARATE from
# SCULPIN_UPSTREAM_API_KEY (S7 completes the broader web/data-plane secret split).
# Never stored in the DB, returned to clients, logged, or recorded in usage events.
SCULPIN_DISCOVERY_API_KEY=
# Keyed HMAC secret for PAT verification, held OUTSIDE the database (>= 32 chars).
# This is the CURRENT key; new PATs are hashed under it.
PAT_HASH_SECRET=
# Version number the CURRENT PAT_HASH_SECRET is stamped under (positive int,
# default 1). Bump this when rotating the key.
PAT_HASH_KEY_VERSION=1
# Optional RETIRED PAT hash keys so tokens minted before a rotation still verify.
# JSON object mapping version-number -> secret (each >= 32 chars). Never a real
# secret in this example. e.g. {"1":"<previous-32+char-secret>"}
PAT_HASH_SECRET_RETIRED=

# Control-plane identity (Better Auth). Names/docs only — never commit real secrets.
# Strong server-side secret used to sign session cookies / auth state (>= 32 chars).
# In production this is sourced from Azure Key Vault, never a committed value.
BETTER_AUTH_SECRET=
# Canonical Hub origin. Used as the trusted origin and OAuth redirect base.
# Must be an https:// origin in production.
BETTER_AUTH_URL=http://localhost:3002
# Google OIDC client credentials (Google Cloud console OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth2 app credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated list of emails granted platform admin on verified sign-in.
# Empty by default; matched case-insensitively against the verified provider email.
BOOTSTRAP_ADMIN_EMAILS=
