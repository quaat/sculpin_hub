{
  "name": "@sculpin/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm --workspace-root prisma:generate && tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretypecheck": "pnpm --workspace-root prisma:generate",
    "pretest": "pnpm --workspace-root prisma:generate",
    "prelint": "pnpm --workspace-root prisma:generate"
  },
  "dependencies": {
    "@sculpin/domain": "workspace:*",
    "@sculpin/jobs": "workspace:*",
    "pg": "8.16.3",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
