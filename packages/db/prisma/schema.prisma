generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  deactivated

  @@map("user_status")
}

enum OrganizationType {
  personal
  team

  @@map("organization_type")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum MembershipRole {
  owner
  member

  @@map("membership_role")
}

enum MembershipStatus {
  active
  inactive

  @@map("membership_status")
}

enum PlatformRole {
  user
  admin

  @@map("platform_role")
}

enum CatalogueEntryStatus {
  draft
  published
  disabled

  @@map("catalogue_entry_status")
}

enum PlanKind {
  free_trial
  commercial_monthly
  commercial_annual

  @@map("plan_kind")
}

enum SubscriptionStatus {
  active
  suspended
  canceled
  expired

  @@map("subscription_status")
}

enum PatStatus {
  active
  revoked

  @@map("pat_status")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedEmail         String                   @map("normalized_email") @db.VarChar(254)
  displayName             String                   @map("display_name") @db.VarChar(120)
  role                    PlatformRole             @default(user)
  status                  UserStatus               @default(active)
  locale                  String                   @default("en") @db.VarChar(16)
  emailVerified           Boolean                  @default(false) @map("email_verified")
  image                   String?                  @db.VarChar(2048)
  deactivatedAt           DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  version                 Int                      @default(1)
  externalIdentities      ExternalIdentity[]
  memberships             OrganizationMembership[]
  personalOrganization    Organization?            @relation("PersonalOrganizationOwner")
  auditEvents             AuditEvent[]
  sessions                Session[]
  catalogueEntriesCreated CatalogueEntry[]         @relation("CatalogueEntryCreatedBy")
  catalogueEntriesUpdated CatalogueEntry[]         @relation("CatalogueEntryUpdatedBy")
  personalAccessTokens    PersonalAccessToken[]

  @@index([normalizedEmail], map: "idx_users_normalized_email")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

// The Hub uses Google/GitHub ONLY to authenticate a person, never to call a
// provider API on the user's behalf. OAuth access/refresh/id tokens are
// therefore NEVER persisted (CLAUDE.md rule 5 / ADR 006). The columns that
// Better Auth's account adapter would otherwise fill (access_token,
// refresh_token, id_token, *_expires_at, scope, password) are DROPPED; the auth
// layer additionally strips those fields before write and disables
// update-on-sign-in so a DB leak yields no usable provider credentials.
model ExternalIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  providerEmail   String?  @map("provider_email") @db.VarChar(254)
  emailVerified   Boolean  @default(false) @map("email_verified")
  metadata        Json?    @map("safe_metadata")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([provider, providerSubject], map: "external_identities_provider_provider_subject_key")
  @@index([userId], map: "idx_external_identities_user_id")
  @@map("external_identities")
}

model Organization {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                   @unique @db.VarChar(63)
  type                 OrganizationType
  personalOwnerUserId  String?                  @map("personal_owner_user_id") @db.Uuid
  personalOwner        User?                    @relation("PersonalOrganizationOwner", fields: [personalOwnerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status               OrganizationStatus       @default(active)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  version              Int                      @default(1)
  memberships          OrganizationMembership[]
  auditEvents          AuditEvent[]
  outboxEvents         OutboxEvent[]
  subscriptions        Subscription[]
  planClaims           PlanClaim[]
  personalAccessTokens PersonalAccessToken[]

  @@unique([personalOwnerUserId], map: "organizations_personal_owner_user_id_key")
  @@index([status], map: "idx_organizations_status")
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  auditEvents    AuditEvent[]

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@index([organizationId, status], map: "idx_memberships_organization_status")
  @@index([userId, status], map: "idx_memberships_user_status")
  @@map("organization_memberships")
}

model AuditEvent {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  systemActor     String?                 @map("system_actor") @db.VarChar(64)
  action          String                  @db.VarChar(120)
  targetType      String                  @map("target_type") @db.VarChar(64)
  targetId        String                  @map("target_id") @db.Uuid
  beforeSummary   Json?                   @map("before_summary")
  afterSummary    Json?                   @map("after_summary")
  requestId       String                  @map("request_id") @db.VarChar(128)
  occurredAt      DateTime                @map("occurred_at") @db.Timestamptz(6)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorUser       User?                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorMembership OrganizationMembership? @relation(fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, occurredAt], map: "idx_audit_events_org_occurred")
  @@map("audit_events")
}

model OutboxEvent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  aggregateType     String        @map("aggregate_type") @db.VarChar(64)
  aggregateId       String        @map("aggregate_id") @db.Uuid
  eventType         String        @map("event_type") @db.VarChar(120)
  schemaVersion     Int           @map("schema_version")
  payload           Json
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(6)
  availableAt       DateTime      @map("available_at") @db.Timestamptz(6)
  claimOwner        String?       @map("claim_owner") @db.VarChar(128)
  claimedUntil      DateTime?     @map("claimed_until") @db.Timestamptz(6)
  attemptCount      Int           @default(0) @map("attempt_count")
  maxAttempts       Int           @default(10) @map("max_attempts")
  processedAt       DateTime?     @map("processed_at") @db.Timestamptz(6)
  terminalErrorCode String?       @map("terminal_error_code") @db.VarChar(80)
  version           Int           @default(1)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, aggregateType, aggregateId], map: "idx_outbox_events_org_aggregate")
  @@map("outbox_events")
}

// M3 model catalogue. Maps a client-visible `public_alias` (the OpenAI `model`
// id) to an internal Sculpin `upstream_agent_id`. Only `published` rows resolve
// (fail closed); the upstream agent id is never projected to clients. Admins are
// recorded via created_by/updated_by for traceability.
model CatalogueEntry {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicAlias       String                       @unique(map: "catalogue_entries_public_alias_key") @map("public_alias") @db.VarChar(64)
  upstreamAgentId   String                       @map("upstream_agent_id") @db.VarChar(255)
  displayName       String                       @map("display_name") @db.VarChar(120)
  description       String?                      @db.VarChar(2048)
  status            CatalogueEntryStatus         @default(draft)
  createdByUserId   String?                      @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?                      @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  version           Int                          @default(1)
  createdBy         User?                        @relation("CatalogueEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedBy         User?                        @relation("CatalogueEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  planLinks         PlanCatalogueEntry[]
  subscriptionLinks SubscriptionCatalogueEntry[]

  @@index([status], map: "idx_catalogue_entries_status")
  @@map("catalogue_entries")
}

// S3 admin-configurable plan (D-019). A plan is a product a tenant can EXPLICITLY
// claim; `plan_catalogue_entries` is the AUTHORITATIVE set of Sculpin agents the
// plan grants. `kind` and the catalogue-entry set are SNAPSHOTTED onto a
// subscription at grant time, so later plan edits never retroactively change an
// existing subscription. `one_time_per_organization` is enforced by a
// `plan_claims` UNIQUE row inserted in the same transaction as the subscription.
model Plan {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String               @unique(map: "plans_key_key") @db.VarChar(63)
  name                   String               @db.VarChar(120)
  description            String?              @db.VarChar(2048)
  kind                   PlanKind
  enabled                Boolean              @default(true)
  published              Boolean              @default(false)
  selfServiceEligible    Boolean              @default(false) @map("self_service_eligible")
  adminGrantable         Boolean              @default(true) @map("admin_grantable")
  durationDays           Int?                 @map("duration_days")
  requestQuota           Int                  @map("request_quota")
  oneTimePerOrganization Boolean              @default(false) @map("one_time_per_organization")
  createdByUserId        String?              @map("created_by") @db.Uuid
  updatedByUserId        String?              @map("updated_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  catalogueEntries       PlanCatalogueEntry[]
  subscriptions          Subscription[]
  planClaims             PlanClaim[]

  @@index([enabled, published], map: "idx_plans_enabled_published")
  @@map("plans")
}

// Admin-configured, AUTHORITATIVE plan→catalogue-entry mapping.
model PlanCatalogueEntry {
  planId           String         @map("plan_id") @db.Uuid
  catalogueEntryId String         @map("catalogue_entry_id") @db.Uuid
  plan             Plan           @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalogueEntry   CatalogueEntry @relation(fields: [catalogueEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([planId, catalogueEntryId])
  @@index([catalogueEntryId], map: "idx_plan_catalogue_entries_entry")
  @@map("plan_catalogue_entries")
}

// One-time-per-organization plan claim ledger. A row (org, plan) is inserted in
// the SAME transaction as the subscription ONLY when the plan is
// one-time-per-organization; the UNIQUE constraint rejects a second claim (23505).
model PlanClaim {
  organizationId String       @map("organization_id") @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  claimedAt      DateTime     @default(now()) @map("claimed_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, planId])
  @@index([planId], map: "idx_plan_claims_plan")
  @@map("plan_claims")
}

// S3 subscription (NO payment provider; D-004/D-019). A subscription is created
// only when a tenant EXPLICITLY claims a plan (`grantFromPlan`); a newly
// provisioned tenant has none. `plan_kind` and the `subscription_catalogue_entries`
// set are SNAPSHOTS taken at grant time from the plan, so later plan edits never
// change an existing subscription. Access requires an ACTIVE, in-quota entitlement
// (the union of a tenant's active subscriptions); `suspended` is not entitling.
// Quota reservation is a single conditional UPDATE (never read-compare-write);
// `quota_used <= quota_limit` is enforced by a DB CHECK (CLAUDE.md rule 6).
model Subscription {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  planId         String                       @map("plan_id") @db.Uuid
  planKind       PlanKind                     @map("plan_kind")
  status         SubscriptionStatus           @default(active)
  quotaLimit     Int                          @map("quota_limit")
  quotaUsed      Int                          @default(0) @map("quota_used")
  startsAt       DateTime                     @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?                    @map("ends_at") @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int                          @default(1)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plan           Plan                         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  offerings      SubscriptionCatalogueEntry[]

  @@index([organizationId, status], map: "idx_subscriptions_org_status")
  @@map("subscriptions")
}

// Per-subscription SNAPSHOT of the catalogue entries granted at claim time.
// Rows are COPIED from `plan_catalogue_entries` when the subscription is created
// and NEVER change afterward — the entitlement→agent mapping is frozen per
// subscription (D-019).
model SubscriptionCatalogueEntry {
  subscriptionId   String         @map("subscription_id") @db.Uuid
  catalogueEntryId String         @map("catalogue_entry_id") @db.Uuid
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalogueEntry   CatalogueEntry @relation(fields: [catalogueEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([subscriptionId, catalogueEntryId])
  @@index([catalogueEntryId], map: "idx_subscription_catalogue_entries_entry")
  @@map("subscription_catalogue_entries")
}

// M5 Personal Access Token (CLAUDE.md rule 2 / ADR 007). The wire token
// `sclp_pat_<public_id>_<secret>` is shown ONCE at mint; only an HMAC-SHA-256
// keyed digest of the secret (`secret_hash`, key `PAT_HASH_SECRET` kept OUTSIDE
// the DB) is stored, so a DB leak yields no usable bearer credential. `public_id`
// is the unauthenticated lookup handle (unique); authentication re-derives an
// active user/org/membership and verifies the secret in constant time. Revocation
// or expiry flips the row out of the active set. The raw secret is NEVER stored.
model PersonalAccessToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId       String       @unique(map: "personal_access_tokens_public_id_key") @map("public_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  secretHash     String       @map("secret_hash") @db.VarChar(128)
  status         PatStatus    @default(active)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int          @default(1)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, status], map: "idx_personal_access_tokens_user_status")
  @@index([organizationId, status], map: "idx_personal_access_tokens_org_status")
  @@map("personal_access_tokens")
}

// Better Auth server-side (database) session. The cookie carries only the
// opaque `token`; all session state lives here. Revocation = delete/expire row.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

// Better Auth verification table (email verification / one-time tokens etc.).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(512)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}
