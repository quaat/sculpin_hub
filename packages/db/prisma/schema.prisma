generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  deactivated

  @@map("user_status")
}

enum OrganizationType {
  personal
  team

  @@map("organization_type")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum MembershipRole {
  owner
  member

  @@map("membership_role")
}

enum MembershipStatus {
  active
  inactive

  @@map("membership_status")
}

enum PlatformRole {
  user
  admin

  @@map("platform_role")
}

model User {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedEmail      String                   @map("normalized_email") @db.VarChar(254)
  displayName          String                   @map("display_name") @db.VarChar(120)
  role                 PlatformRole             @default(user)
  status               UserStatus               @default(active)
  locale               String                   @default("en") @db.VarChar(16)
  emailVerified        Boolean                  @default(false) @map("email_verified")
  image                String?                  @db.VarChar(2048)
  deactivatedAt        DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  version              Int                      @default(1)
  externalIdentities   ExternalIdentity[]
  memberships          OrganizationMembership[]
  personalOrganization Organization?            @relation("PersonalOrganizationOwner")
  auditEvents          AuditEvent[]
  sessions             Session[]

  @@index([normalizedEmail], map: "idx_users_normalized_email")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

// The Hub uses Google/GitHub ONLY to authenticate a person, never to call a
// provider API on the user's behalf. OAuth access/refresh/id tokens are
// therefore NEVER persisted (CLAUDE.md rule 5 / ADR 006). The columns that
// Better Auth's account adapter would otherwise fill (access_token,
// refresh_token, id_token, *_expires_at, scope, password) are DROPPED; the auth
// layer additionally strips those fields before write and disables
// update-on-sign-in so a DB leak yields no usable provider credentials.
model ExternalIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  providerEmail   String?  @map("provider_email") @db.VarChar(254)
  emailVerified   Boolean  @default(false) @map("email_verified")
  metadata        Json?    @map("safe_metadata")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([provider, providerSubject], map: "external_identities_provider_provider_subject_key")
  @@index([userId], map: "idx_external_identities_user_id")
  @@map("external_identities")
}

model Organization {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String                   @unique @db.VarChar(63)
  type                OrganizationType
  personalOwnerUserId String?                  @map("personal_owner_user_id") @db.Uuid
  personalOwner       User?                    @relation("PersonalOrganizationOwner", fields: [personalOwnerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status              OrganizationStatus       @default(active)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  version             Int                      @default(1)
  memberships         OrganizationMembership[]
  auditEvents         AuditEvent[]
  outboxEvents        OutboxEvent[]

  @@unique([personalOwnerUserId], map: "organizations_personal_owner_user_id_key")
  @@index([status], map: "idx_organizations_status")
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  auditEvents    AuditEvent[]

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@index([organizationId, status], map: "idx_memberships_organization_status")
  @@index([userId, status], map: "idx_memberships_user_status")
  @@map("organization_memberships")
}

model AuditEvent {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  systemActor     String?                 @map("system_actor") @db.VarChar(64)
  action          String                  @db.VarChar(120)
  targetType      String                  @map("target_type") @db.VarChar(64)
  targetId        String                  @map("target_id") @db.Uuid
  beforeSummary   Json?                   @map("before_summary")
  afterSummary    Json?                   @map("after_summary")
  requestId       String                  @map("request_id") @db.VarChar(128)
  occurredAt      DateTime                @map("occurred_at") @db.Timestamptz(6)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorUser       User?                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorMembership OrganizationMembership? @relation(fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, occurredAt], map: "idx_audit_events_org_occurred")
  @@map("audit_events")
}

model OutboxEvent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  aggregateType     String        @map("aggregate_type") @db.VarChar(64)
  aggregateId       String        @map("aggregate_id") @db.Uuid
  eventType         String        @map("event_type") @db.VarChar(120)
  schemaVersion     Int           @map("schema_version")
  payload           Json
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(6)
  availableAt       DateTime      @map("available_at") @db.Timestamptz(6)
  claimOwner        String?       @map("claim_owner") @db.VarChar(128)
  claimedUntil      DateTime?     @map("claimed_until") @db.Timestamptz(6)
  attemptCount      Int           @default(0) @map("attempt_count")
  maxAttempts       Int           @default(10) @map("max_attempts")
  processedAt       DateTime?     @map("processed_at") @db.Timestamptz(6)
  terminalErrorCode String?       @map("terminal_error_code") @db.VarChar(80)
  version           Int           @default(1)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, aggregateType, aggregateId], map: "idx_outbox_events_org_aggregate")
  @@map("outbox_events")
}

// Better Auth server-side (database) session. The cookie carries only the
// opaque `token`; all session state lives here. Revocation = delete/expire row.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

// Better Auth verification table (email verification / one-time tokens etc.).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(512)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}
